# Forge defaults — copy to .env and customize
FORGE_WORKSPACE=/workspace
FORGE_PROVIDER=ollama
FORGE_MODEL=qwen2.5-coder:7b
FORGE_BASE_URL=http://host.docker.internal:11434

# Security — the API can run shell commands. Keep the port on localhost.
# Set a token to require `Authorization: Bearer <token>` on /api/* (the client
# reads it from VITE_FORGE_AUTH_TOKEN or localStorage "forge_auth_token").
# FORGE_AUTH_TOKEN=change-me
# Extra Host header values allowed (comma-separated) if you front Forge with a
# reverse proxy on a hostname; localhost/127.0.0.1 are always allowed.
# FORGE_ALLOWED_HOSTS=forge.example.com
# Extra browser Origins allowed for cross-origin requests (comma-separated).
# FORGE_ALLOWED_ORIGINS=http://localhost:5173

# Cloud providers (pick one)
# FORGE_PROVIDER=openai
# FORGE_API_KEY=sk-...
# FORGE_MODEL=gpt-4o

# FORGE_PROVIDER=anthropic
# FORGE_API_KEY=sk-ant-...
# FORGE_MODEL=claude-sonnet-4-20250514

# FORGE_PROVIDER=openrouter
# FORGE_API_KEY=sk-or-...
# FORGE_MODEL=anthropic/claude-sonnet-4

# Homelab AnythingLLM
# FORGE_PROVIDER=anythingllm
# FORGE_BASE_URL=http://host.docker.internal:3002
# FORGE_API_KEY=your-anythingllm-key
# FORGE_MODEL=default

PORT=3100
